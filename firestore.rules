rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'hmazoulay@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['fullName', 'phoneNumber', 'language', 'status', 'createdAt'])
        && data.keys().hasOnly(['fullName', 'phoneNumber', 'language', 'status', 'createdAt'])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && data.phoneNumber is string
        && data.phoneNumber.size() >= 5
        && data.phoneNumber.size() <= 32
        && data.phoneNumber.matches('^[+0-9()\\-\\s.]{5,32}$')
        && data.language is string
        && data.language in ['en', 'fr', 'he']
        && data.status is string
        && data.status in ['new', 'contacted']
        && data.createdAt is timestamp;
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isAdmin();
      allow list: if isAdmin();

      // Visitors can submit the inquiry form without signing in,
      // strictly bounded by schema validation and server timestamp enforcement.
      allow create: if isValidId(submissionId)
        && isValidSubmission(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time;

      // Only the verified business owner can update follow-up status.
      allow update: if isValidId(submissionId)
        && isAdmin()
        && isValidSubmission(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().fullName == existing().fullName
        && incoming().phoneNumber == existing().phoneNumber
        && incoming().language == existing().language
        && incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(submissionId) && isAdmin();
    }
  }
}
